{
    "name": "@persian-caesar/bale.js",
    "version": "0.1.0",
    "description": "A powerful library for building Bale messenger bots.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "docs": "typedoc",
        "prepublishOnly": "npm run build && npm run test"
    },
    "keywords": [
        "bale",
        "bot",
        "messenger",
        "api",
        "typescript",
        "discord.js-like",
        "bale.js",
        "bale.ai",
        "persian",
        "discord",
        "downloader",
        "telegram",
        "chatplatform",
        "js",
        "node.js",
        "package",
        "bale-js",
        "bale-bot",
        "npm",
        "persian-caesar",
        "sobhan-srza"
    ],
    "author": "Sobhan-SRZA (mr.sinre) from Persian Caesar",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Persian-Caesar/bale.js/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Persian-Caesar/bale.js.git"
    },
    "homepage": "https://github.com/Persian-Caesar/bale.js#readme",
    "dependencies": {
        "undici": "^6.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/node": "^22.0.0",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^9.0.0",
        "prettier": "^3.4.0",
        "typedoc": "^0.28.20",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "^5.1.0"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18.0.0"
    }
}