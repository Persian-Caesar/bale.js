{
    "name": "bale.js",
    "version": "0.1.0",
    "description": "A powerful, discord.js-like library for building Bale messenger bots.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "bale",
        "bot",
        "messenger",
        "api",
        "typescript",
        "discord.js-like"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "undici": "^6.0.0"
    },
    "devDependencies": {
        "typescript": "^5.0.0",
        "@types/node": "^20.0.0",
        "eslint": "^8.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "prettier": "^3.0.0"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18.0.0"
    }
}