{
    "name": "bale.js",
    "version": "0.1.0",
    "description": "A powerful library for building Bale messenger bots.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.ts\"",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "bale",
        "bot",
        "messenger",
        "api",
        "typescript",
        "discord.js-like"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "undici": "^6.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/node": "^22.0.0",
        "eslint": "^9.0.0",
        "prettier": "^3.4.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.0.0"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18.0.0"
    }
}
